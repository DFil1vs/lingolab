  "grammar": [
    { "question": "I ___ a student.", "options": ["am", "is", "are", "be"], "answer": "am", "explanation": "Use am with I: I am a student.", "explanationRu": "С I используем am: I am — я являюсь." },
    { "question": "She ___ English every day.", "options": ["study", "studies", "studying", "are study"], "answer": "studies", "explanation": "With he, she and it in the present simple, study becomes studies.", "explanationRu": "В Present Simple после he, she, it глагол study меняется на studies." },
    { "question": "They ___ my friends.", "options": ["is", "am", "are", "be"], "answer": "are", "explanation": "Use are with they, we and you.", "explanationRu": "С they, we и you используем are." },
    { "question": "I have ___ apple.", "options": ["a", "an", "two", "are"], "answer": "an", "explanation": "Use an before a vowel sound: an apple.", "explanationRu": "Перед гласным звуком используем an: an apple." },
    { "question": "He ___ like coffee.", "options": ["don't", "doesn't", "isn't", "aren't"], "answer": "doesn't", "explanation": "Use doesn't + the base verb with he, she and it.", "explanationRu": "Для отрицания с he, she, it используем doesn't + глагол без окончания." },
    { "question": "___ you speak English?", "options": ["Does", "Do", "Is", "Am"], "answer": "Do", "explanation": "Use Do to ask a present simple question with you.", "explanationRu": "Вопрос в Present Simple с you начинается с Do." },
    { "question": "There ___ a book on the table.", "options": ["are", "am", "is", "be"], "answer": "is", "explanation": "Use there is for one thing: a book.", "explanationRu": "Для одного предмета используем there is." },
    { "question": "We go to school ___ Monday.", "options": ["in", "at", "on", "to"], "answer": "on", "explanation": "Use on with days of the week.", "explanationRu": "С днями недели используем предлог on." },
    { "question": "This is ___ book.", "options": ["I", "me", "my", "mine"], "answer": "my", "explanation": "Use my before a noun: my book.", "explanationRu": "Перед существительным используем my: my book — моя книга." },
    { "question": "Look! The cat ___ sleeping.", "options": ["are", "am", "is", "do"], "answer": "is", "explanation": "Use is + verb-ing for one thing happening now.", "explanationRu": "Для действия одного предмета прямо сейчас: is + глагол с -ing." },
    { "question": "Yesterday, I ___ at home.", "options": ["am", "are", "was", "were"], "answer": "was", "explanation": "Use was with I for the past: I was at home.", "explanationRu": "В прошедшем времени с I используем was." },
    { "question": "There are two ___ in my bag.", "options": ["book", "books", "a book", "booking"], "answer": "books", "explanation": "Add -s to make the plural of book: two books.", "explanationRu": "Во множественном числе добавляем -s: two books — две книги." }
  ],
